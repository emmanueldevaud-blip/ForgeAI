# Application
APP_NAME="ForgeAI Demo"
APP_VERSION="1.0.0"
DEBUG=true

# SECURITY - REQUIRED: Generate with: openssl rand -hex 32
SECRET_KEY="your-super-secret-key-change-in-production-min-32-chars"

# JWT
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database - REQUIRED: MySQL 8.4 connection string
# Format: mysql://user:password@host:port/database
DATABASE_URL="mysql://forgeai:forgeai_password@localhost:3306/forgeai"
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# CORS - Frontend URL
CORS_ORIGINS='["http://localhost:8000"]'

# Local Authentication
AUTH_LOCAL_ENABLED=true
BCRYPT_ROUNDS=12

# Active Directory / LDAP Configuration
AD_ENABLED=false
AD_SERVER="ad.example.com"
AD_PORT=636
AD_USE_SSL=true
AD_BASE_DN="DC=example,DC=com"
AD_USER_DN="OU=Users,DC=example,DC=com"
AD_USER_SEARCH_FILTER="(sAMAccountName={username})"
AD_GROUP_SEARCH_BASE="OU=Groups,DC=example,DC=com"
AD_ADMIN_GROUP="CN=AppAdmins,OU=Groups,DC=example,DC=com"
AD_BIND_USER="CN=svc_forgeai,OU=ServiceAccounts,DC=example,DC=com"
AD_BIND_PASSWORD="your-bind-password"
AD_CONNECT_TIMEOUT=10
AD_RECEIVE_TIMEOUT=10
AD_GROUP_MAPPING='{"admin": "AppAdmins", "user": "AppUsers"}'

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Sport Coach IA - Gemini API (quota gratuit selon modèle et projet)
SPORT_AI_PROVIDER=gemini
SPORT_AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
SPORT_AI_API_KEY=""
SPORT_AI_MODEL="gemini-3.7-flash"
SPORT_AI_TIMEOUT_SECONDS=20

# AI Gateway - passerelle IA centralisée (Groq / Gemini / OpenRouter)
AI_GATEWAY_ENABLED=true
AI_DEFAULT_PROVIDER=auto
AI_DEFAULT_MODEL=auto
AI_PROVIDER_ORDER=groq,gemini,openrouter
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=1.0

# Provider Groq
GROQ_ENABLED=true
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL=""

# Provider Google Gemini
GEMINI_ENABLED=true
GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
GEMINI_MODEL=""

# Provider OpenRouter
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL=""

# Sport - analyses automatiques (matin / soir / 15 min apres une activite Garmin)
SPORT_ANALYSIS_ENABLED=true
SPORT_MORNING_ANALYSIS_ENABLED=true
SPORT_MORNING_ANALYSIS_TIME=07:00
# Attente de la nuit synchronisee (Garmin) avant l'analyse du matin, au plus tard a cette heure.
SPORT_MORNING_ANALYSIS_DEADLINE=10:00
SPORT_EVENING_ANALYSIS_ENABLED=true
SPORT_EVENING_ANALYSIS_TIME=20:00
SPORT_ACTIVITY_ANALYSIS_ENABLED=true
SPORT_ACTIVITY_ANALYSIS_DELAY_MINUTES=15
SPORT_ANALYSIS_TIMEZONE=Europe/Paris
# Conseils ponctuels du coach (hors analyses) : maximum envoyes par jour.
COACH_TIP_DAILY_LIMIT=2

# Agent Sport (coach autonome : decide des analyses, conseils et notifications)
# false = repli automatique sur les jobs historiques.
SPORT_AGENT_ENABLED=true
SPORT_AGENT_MAX_STEPS=5
SPORT_AGENT_MAX_TOOL_CALLS=16
SPORT_AGENT_TIMEOUT_SECONDS=60

# Notifications Web Push vers le telephone (repliquees sur la montre Garmin Connect)
# Sans ces cles VAPID, les notifications restent consultables dans ForgeAI (in-app).
NOTIFICATION_VAPID_PUBLIC_KEY=""
NOTIFICATION_VAPID_PRIVATE_KEY=""
NOTIFICATION_VAPID_SUBJECT="mailto:admin@example.com"

# Photos (gestionnaire de photos personnelles)
PHOTO_ENABLED=true
# Stockage des originaux / miniatures / versions derivees (sous-data/photos).
PHOTO_STORAGE_PATH="data/photos"
# Vide = sous-dossier "thumbs" de PHOTO_STORAGE_PATH.
PHOTO_THUMBNAIL_PATH=""
PHOTO_MAX_UPLOAD_SIZE=52428800
PHOTO_THUMBNAIL_SIZES="tiny:96,small:256,medium:640,large:1280,preview:2048"
PHOTO_BACKGROUND_JOBS=true
PHOTO_ANALYSIS_ENABLED=true
# Analyseur : "metadata" (local, sans modele) — les analyseurs visuels sont prepares.
PHOTO_ANALYZER="metadata"
# Score de qualite ajoute au resultat de l'analyse (calcule sur une miniature).
PHOTO_QUALITY_ENABLED=true
# Embedding image pour « photos similaires » — provider local, aucun appel réseau.
PHOTO_EMBEDDING_ENABLED=true
PHOTO_EMBEDDING_PROVIDER="local_grid"
# Miniature utilisee pour l'analyse et l'embedding (performance).
PHOTO_ANALYSIS_THUMB_SIZE="medium"
PHOTO_FACE_ENABLED=true
# Détecteur de visages : "local_heuristic" = heuristique locale (Pillow),
# aucun appel réseau, aucune donnée de visage transmise à l'extérieur.
PHOTO_FACE_DETECTOR="local_heuristic"
# Regroupement automatique en groupes anonymes (« Personne 1 », « Personne 2 »...).
PHOTO_FACE_GROUPING_ENABLED=true
# Seuils de similarité cosinus (0..1) : rejoindre un groupe / fusionner deux groupes.
PHOTO_FACE_GROUP_THRESHOLD=0.90
PHOTO_FACE_GROUP_MERGE_THRESHOLD=0.97
PHOTO_AI_SEARCH_ENABLED=true
# Opt-in : appels a une API de geocodage externe (cache en base).
PHOTO_GEOCODING_ENABLED=false

# --- V3 : stockage des originaux --------------------------------------------
# "local" = repertoire PHOTO_STORAGE_PATH (comportement historique).
# "nas"   = repertoire PHOTO_NAS_PATH deja monte par le systeme
#           (ex. /mnt/synology/photos). ForgeAI ne gere ni SMB ni NFS.
PHOTO_STORAGE_BACKEND="local"
PHOTO_NAS_PATH=""
# Scan automatique en arriere-plan du repertoire NAS (job "scan_import").
PHOTO_NAS_SCAN_ENABLED=false
PHOTO_NAS_SCAN_INTERVAL_SECONDS=300
