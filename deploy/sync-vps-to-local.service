[Unit]
Description=Sync VPS Database to Local
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/home/edevaud/forgeai/deploy/sync-vps-to-local.sh
User=edevaud
Group=docker
WorkingDirectory=/home/edevaud/forgeai
# Un import complet peut dépasser le délai systemd par défaut de 90 secondes.
TimeoutStartSec=2h
TimeoutStopSec=5min
