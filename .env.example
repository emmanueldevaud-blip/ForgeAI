# Application
APP_NAME="ForgeAI Demo"
APP_VERSION="1.0.0"
DEBUG=true

# SECURITY - REQUIRED: Generate with: openssl rand -hex 32
SECRET_KEY="your-super-secret-key-change-in-production-min-32-chars"

# JWT
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database - REQUIRED: MySQL 8.4 connection string
# Format: mysql://user:password@host:port/database
DATABASE_URL="mysql://forgeai:forgeai_password@localhost:3306/forgeai"
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# CORS - Frontend URL
CORS_ORIGINS='["http://localhost:8000"]'

# Local Authentication
AUTH_LOCAL_ENABLED=true
BCRYPT_ROUNDS=12

# Active Directory / LDAP Configuration
AD_ENABLED=false
AD_SERVER="ad.example.com"
AD_PORT=636
AD_USE_SSL=true
AD_BASE_DN="DC=example,DC=com"
AD_USER_DN="OU=Users,DC=example,DC=com"
AD_USER_SEARCH_FILTER="(sAMAccountName={username})"
AD_GROUP_SEARCH_BASE="OU=Groups,DC=example,DC=com"
AD_ADMIN_GROUP="CN=AppAdmins,OU=Groups,DC=example,DC=com"
AD_BIND_USER="CN=svc_forgeai,OU=ServiceAccounts,DC=example,DC=com"
AD_BIND_PASSWORD="your-bind-password"
AD_CONNECT_TIMEOUT=10
AD_RECEIVE_TIMEOUT=10
AD_GROUP_MAPPING='{"admin": "AppAdmins", "user": "AppUsers"}'

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Sport Coach IA - Gemini API (quota gratuit selon modèle et projet)
SPORT_AI_PROVIDER=gemini
SPORT_AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
SPORT_AI_API_KEY=""
SPORT_AI_MODEL="gemini-3.7-flash"
SPORT_AI_TIMEOUT_SECONDS=20

# AI Gateway - passerelle IA centralisée (Groq / Gemini / OpenRouter)
AI_GATEWAY_ENABLED=true
AI_DEFAULT_PROVIDER=auto
AI_DEFAULT_MODEL=auto
AI_PROVIDER_ORDER=groq,gemini,openrouter
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=1.0

# Provider Groq
GROQ_ENABLED=true
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL=""

# Provider Google Gemini
GEMINI_ENABLED=true
GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
GEMINI_MODEL=""

# Provider OpenRouter
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL=""

# Sport - analyses automatiques (matin / soir / 15 min apres une activite Garmin)
SPORT_ANALYSIS_ENABLED=true
SPORT_MORNING_ANALYSIS_ENABLED=true
SPORT_MORNING_ANALYSIS_TIME=07:00
# Attente de la nuit synchronisee (Garmin) avant l'analyse du matin, au plus tard a cette heure.
SPORT_MORNING_ANALYSIS_DEADLINE=10:00
SPORT_EVENING_ANALYSIS_ENABLED=true
SPORT_EVENING_ANALYSIS_TIME=20:30
SPORT_ACTIVITY_ANALYSIS_ENABLED=true
SPORT_ACTIVITY_ANALYSIS_DELAY_MINUTES=15
SPORT_ANALYSIS_TIMEZONE=Europe/Paris

# Notifications Web Push vers le telephone (repliquees sur la montre Garmin Connect)
# Sans ces cles VAPID, les notifications restent consultables dans ForgeAI (in-app).
NOTIFICATION_VAPID_PUBLIC_KEY=""
NOTIFICATION_VAPID_PRIVATE_KEY=""
NOTIFICATION_VAPID_SUBJECT="mailto:admin@example.com"
